# Django
# SECRET_KEY is required once DEBUG=False; a local-only default is used otherwise.
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# CSRF - comma-separated list of trusted origins (scheme required), only needed
# for Django admin login once it's served over a real domain/HTTPS.
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL)
DB_NAME=stone_paper_scissors
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# HTTPS security settings - leave False for local HTTP development.
# Set to True once the app is served over HTTPS (e.g. behind Nginx on AWS).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
